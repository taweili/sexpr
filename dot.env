# SPDX-License-Identifier: Unlicense
# dot.env — annotated template: every environment variable the wrappers and
# clients read, shown with its default and left commented out.
#
#   cp dot.env .env           # then edit .env
#
# Both wrappers load .env from their own directory before applying defaults.
# Exported variables win over .env; a variable set in neither place gets the
# built-in default. Values are literal: no ${...} expansion and no ~ expansion,
# so paths must be absolute. Quote a value only if you mean the quotes.
#
# Precedence: exported variable > .env > built-in default.

# --- loading ---------------------------------------------------------------
# Which .env to read (default: the .env beside the wrapper). Absolute path.
# SEXPR_ENV_FILE=/absolute/path/to/.env

# --- model provider (sexpr.sh, sexpr-tui.sh, and the image they start) -----
# Provider name: anthropic | openai | gemini | openrouter | ollama |
#                openai-compatible
# SEXPR_PROVIDER=openai-compatible
# Base URL for an OpenAI-compatible endpoint. When set with SEXPR_PROVIDER
# unset, the provider auto-infers to openai-compatible.
# SEXPR_BASE_URL=http://localhost:6969/v1
# Model name; unset means the provider's own default.
# SEXPR_MODEL=Qwythos-9B-v2

# Comma-separated capability grants (additive with the built-in fs-read).
#   built-in tool caps:      fs-read fs-write process lisp-eval
#   multi-agent coord caps:  spawn collect manage inspect
# Set to fs-read alone for a read-only session.
# SEXPR_CAPABILITIES=fs-read,fs-write,process,lisp-eval,spawn,collect,manage,inspect

# --- provider credentials (read directly by cl-llm-provider) ---------------
# sexpr never sees keys: the transport reads these names from the environment.
# Leave the ones you do not use commented or empty.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# Ollama endpoint (its built-in default is http://localhost:11434; no key).
# OLLAMA_BASE_URL=http://localhost:11434

# --- remote TUI wrapper (sexpr-tui.sh) --------------------------------------
# Image host and the two channel ports (swank request/response, push deltas).
# SEXPR_TUI_HOST=127.0.0.1
# SEXPR_TUI_SWANK_PORT=4004
# SEXPR_TUI_PUSH_PORT=4005
# Boot file, pid and logs live here.
# SEXPR_TUI_STATE_DIR=/tmp/sexpr-tui
# Seconds to wait for the image to bind swank.
# SEXPR_TUI_READY_TIMEOUT=120
# SBCL binary to launch.
# SEXPR_TUI_SBCL=sbcl
# SBCL init file (default: ~/.sbclinit). Absolute path; ~ is not expanded.
# SEXPR_TUI_SBCLINIT=/home/YOUR-USER/.sbclinit
# Seed an idle placeholder agent at image boot (goal "hello world"). This is
# what makes Enter work on a fresh image: the client picks its chat agent from
# the first snapshot row, so with no rows the pane is blank and has nowhere to
# send. The seed starts NO worker thread and costs NO model round — the agent
# reads IDLE until you type.
# SEXPR_TUI_SEED=1
# Give that agent a "hello world" note on boot so it greets before you type.
# Costs one model round per image boot, including --server-only, which never
# opens a TUI. Off by default: otherwise the chat starts by itself.
# SEXPR_TUI_GREETER=0

# --- TUI client knobs (src/tui-client/, read once before the first layout) --
# Booleans accept 1 t true yes on (case-insensitive); anything else is false.
# SEXPR_TUI_MULTILINE=0        # three-row chat input; Enter=newline, Ctrl+J=send
# SEXPR_TUI_COMPACT=0          # drop pane borders, give the columns to the transcript
# SEXPR_TUI_TIMESTAMPS=0       # prefix chat lines with local [HH:MM]
# SEXPR_TUI_ROLE_STYLES=0      # colour the leading role token
# Border/cursor accent colour. Words: cyan green red yellow blue magenta white
# black bright-black bright-white. Empty (the default) keeps the stock accent.
# SEXPR_TUI_FOCUS_COLOR=
# Log destination: T = stderr, empty (the default) = off, anything else = file.
# SEXPR_TUI_LOG=
# Seconds to wait for one TCP connect (float; unparseable falls back to 10.0).
# SEXPR_TUI_CONNECT_TIMEOUT=10.0

# --- test hook (tools/check-saved-transcript.lisp) --------------------------
# Not operator configuration: `make test-live` sets both itself, and the checker
# fails when either is missing. Listed so this file names every variable read.
# SEXPR_TRANSCRIPT=/tmp/sexpr-transcript.sexp
# SEXPR_FIXTURE=hello world

